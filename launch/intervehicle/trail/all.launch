#!/usr/bin/env -S goby_launch -s -P -k30 -ptrail -d500 -L

# one USV and two AUVs; to add an AUV, raise trail_n_auvs on every line and add an auv.launch line
goby_launch -P -d100 topside.launch
[env=trail_n_auvs=2] goby_launch -P -d100 usv.launch
[env=trail_n_auvs=2, env=trail_auv_index=0] goby_launch -P -d100 auv.launch
[env=trail_n_auvs=2, env=trail_auv_index=1] goby_launch -P -d100 auv.launch
